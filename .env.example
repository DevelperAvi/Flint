# ─────────────────────────────────────────────────────────────────────────────
# Flint Platform — Environment Variables
# Copy this file to .env and fill in your actual values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ── PostgreSQL Database ────────────────────────────────────────────────────────
# Supabase / Pooler:
DATABASE_URL="postgresql://postgres.rbwhhycfwtkrvywhfdzd:[YOUR-PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.rbwhhycfwtkrvywhfdzd:[YOUR-PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:5432/postgres"

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local Docker:   redis://localhost:6379
# Production:     redis://:password@host:6379/0
REDIS_URL=redis://localhost:6379

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# IMPORTANT: Change these to long, random strings in production!
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-this-in-production-min32
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this-in-production-min32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── S3 / Object Storage ───────────────────────────────────────────────────────
# For LOCAL development with MinIO:
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET_NAME=flint-media
S3_PUBLIC_URL=http://localhost:9000/flint-media

# For Cloudflare R2 (production):
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your-r2-access-key-id
# S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
# S3_BUCKET_NAME=flint-media
# S3_PUBLIC_URL=https://your-custom-domain.com  (or R2 public URL)

# For AWS S3 (production):
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_BUCKET_NAME=flint-media
# S3_PUBLIC_URL=https://flint-media.s3.amazonaws.com

# ── MinIO (local S3 emulator) ─────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ── BullMQ / Worker ───────────────────────────────────────────────────────────
BULL_CONCURRENCY=5

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
